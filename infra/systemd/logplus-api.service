[Unit]
Description=LogPlus FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/app/logplus-platform/apps/api
Environment=APP_LOG_ROOT=/app/logs
Environment=USER_LOG_ROOT=/app/logplus-platform/logs
ExecStartPre=/usr/bin/mkdir -p /app/logs/api
ExecStart=/usr/local/bin/uvicorn main:app --host 0.0.0.0 --port 8000
StandardOutput=append:/app/logs/api/app.log
StandardError=append:/app/logs/api/app.log
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
